{
  "name": "flux-pipeline",
  "version": "0.9.4",
  "fluxVersion": "0.9.004",
  "description": "FLUX Pipeline Hub",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:backend": "python backend/main.py",
    "dev": "tsc -p tsconfig.electron.json && concurrently -k -n vite,electron -c green,magenta \"vite\" \"electron .\"",
    "build:frontend": "vite build",
    "build:backend": "python -m PyInstaller scripts/backend.spec --distpath backend/dist --noconfirm",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "node scripts/build.cjs",
    "dist": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "FLUX Pipeline",
  "license": "Apache-2.0",
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.0",
    "concurrently": "^8.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.390.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@xyflow/react": "^12.11.6",
    "react-hook-form": "^7.76.0",
    "sonner": "^2.0.7"
  }
}
