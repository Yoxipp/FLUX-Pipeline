# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# PyInstaller output (build/ = cache intermédiaire PyInstaller)
dist/
build/
# ...but 'build/' above is a source package for the USD assembler, not PyInstaller output.
!backend/features/**/build/
!backend/features/**/build/*.py

# Electron / TypeScript build artifacts
tsconfig.electron.tsbuildinfo
dist-electron/

# electron-builder output
release/

# Node
node_modules/

# IDE
.vscode/
.idea/
*.swp

# Flux runtime — never commit these (generated at launch)
config.json
USER/
CONFIG/
DOSSIER_PROJETS/
FLUX_UPDATE/*.exe
test/
.flux

# ...but flux_actions/config holds SOURCE action YAML, not runtime.
# The CONFIG/ rule above catches it on case-insensitive filesystems; keep it.
!backend/flux_actions/config/
!backend/flux_actions/config/*.yml

# OS
.DS_Store
Thumbs.db
desktop.ini
INSTALLEURS/

# Runtime temp
.flux_tmp_*.json
backend_port
flux_dev.log

# Houdini HDA auto-backups (createDigitalAsset)
backend/resources/shelves/houdini/backup/

# AI agent tooling: local settings and vendored third-party skills are not FLUX
# source (skills are reinstalled from skills-lock.json / `npx gitnexus analyze`).
.local/settings.local.json
.local/skills/*
# FLUX-owned skills (USD knowledge, VFX USD Survival Guide adapted, Apache-2.0) are versioned.
!.local/skills/flux-usd-pipeline/
!.local/skills/usd-*/
.local/worktrees/
state/

# Session scratch files
scratchpad/

# Houdini session outputs written at the repo root when $HIP points here
/untitled.hip
/sourceimages/
/flux_anim/
/skills-lock.json
