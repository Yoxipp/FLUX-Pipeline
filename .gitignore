# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# PyInstaller output
dist/
build/
# keep flux.spec tracked — only ignore generated specs
!flux.spec
# keep electron-builder icon tracked — required on every dev machine to build the MSI
!build/icon.ico

# IDE
.vscode/
.idea/
*.swp

# Flux runtime — never commit these (generated at launch)
config.json
USER/
CONFIG/
DOSSIER_PROJETS/
FLUX_UPDATE/*.exe
TEST/
.flux

# OS
.DS_Store
Thumbs.db
desktop.ini
INSTALLEURS/Flux_Installer_v0.1.0.exe
