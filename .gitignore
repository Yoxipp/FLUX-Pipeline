# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# PyInstaller output (build/ = cache intermédiaire PyInstaller)
dist/
build/
# ...but 'build/' above is a source package for the USD assembler, not PyInstaller output.
!backend/features/**/build/
!backend/features/**/build/*.py

# Electron / TypeScript build artifacts
tsconfig.electron.tsbuildinfo
dist-electron/

# electron-builder output
release/

# Node
node_modules/

# IDE
.vscode/
.idea/
*.swp

# Flux runtime — never commit these (generated at launch)
config.json
USER/
CONFIG/
DOSSIER_PROJETS/
FLUX_UPDATE/*.exe
TEST/
.flux

# ...but flux_actions/config holds SOURCE action YAML, not runtime.
# The CONFIG/ rule above catches it on case-insensitive filesystems; keep it.
!backend/flux_actions/config/
!backend/flux_actions/config/*.yml

# OS
.DS_Store
Thumbs.db
desktop.ini
INSTALLEURS/

# Runtime temp
.flux_tmp_*.json
backend_port
flux_dev.log

# Houdini HDA auto-backups (createDigitalAsset)
backend/resources/shelves/houdini/backup/
