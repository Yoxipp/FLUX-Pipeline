// shelf_Flux.mel — Flux shelf for Autodesk Maya.
// Installed by the Flux Shelf Manager into ~/maya/<version>/prefs/shelves/.
// Maya auto-sources this file on startup because the proc matches the filename.

global proc shelf_Flux() {
    shelfButton
        -label        "Publish"
        -annotation   "Flux — Publish asset to pipeline"
        -image1       "commandButton.png"
        -sourceType   "python"
        -command      "from flux.dcc.maya import maya_publish; maya_publish.publish()"
    ;
    shelfButton
        -label        "Import"
        -annotation   "Flux — Import asset from pipeline"
        -image1       "commandButton.png"
        -sourceType   "python"
        -command      "from flux.dcc.maya import maya_import; maya_import.open_importer()"
    ;
    shelfButton
        -label        "Connect"
        -annotation   "Flux — Open commandPort (port 7001)"
        -image1       "commandButton.png"
        -sourceType   "python"
        -command      "import maya.cmds as mc\nmc.commandPort(name='127.0.0.1:7001', sourceType='python')"
    ;
    shelfButton
        -label        "Hub"
        -annotation   "Flux — Open Hub window"
        -image1       "commandButton.png"
        -sourceType   "python"
        -command      "from flux.dcc.maya import maya_connection; maya_connection.open_hub()"
    ;
}
