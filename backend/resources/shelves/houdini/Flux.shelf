<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- Flux shelf for SideFX Houdini: one button per FLUX node (HDA).            -->
  <!-- This file IS the source; shelf install copies it to houdiniX.Y/toolbar.  -->
  <!-- Edit here, then reinstall the Houdini shelf from the FLUX Shelf Manager. -->

  <tool name="flux_tool_import" label="FLUX Import" icon="opdef:/Lop/flux_importer?IconSVG">
    <helpText><![CDATA[Import a FLUX publish (asset, component, set). LOP in /stage, SOP in a geo network.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou

TYPE_NAME = "flux_importer"
pane = hou.ui.paneTabOfType(hou.paneTabType.NetworkEditor)
here = pane.pwd() if pane else None
cats = [c for c in (hou.lopNodeTypeCategory(), hou.sopNodeTypeCategory(), hou.objNodeTypeCategory())
        if hou.nodeType(c, TYPE_NAME) is not None]
if not cats:
    hou.ui.displayMessage(
        "HDA FLUX absent : " + TYPE_NAME + ". Installe la shelf Houdini depuis FLUX (Shelf Manager).",
        severity=hou.severityType.Error)
    raise hou.InterruptedError()
# Placed where the network editor is: /stage (LOP), a geo network (SOP), /obj (OBJ).
# A context without this node: /obj gets a geo holding the SOP one, else /stage.
if here is not None and here.childTypeCategory() in cats:
    parent = here
elif (here is not None and here.childTypeCategory() == hou.objNodeTypeCategory()
      and hou.sopNodeTypeCategory() in cats):
    parent = here.createNode("geo", TYPE_NAME + "_geo")
elif hou.lopNodeTypeCategory() in cats:
    parent = hou.node("/stage") or hou.node("/").createNode("lopnet", "stage")
elif hou.sopNodeTypeCategory() in cats:
    parent = hou.node("/obj").createNode("geo", TYPE_NAME + "_geo")
else:
    parent = hou.node("/obj")
node = parent.createNode(TYPE_NAME)
node.moveToGoodPosition()
node.setSelected(True, clear_all_selected=True)
if pane is not None and pane.pwd() != parent:
    pane.setPwd(parent)
]]></script>
  </tool>

