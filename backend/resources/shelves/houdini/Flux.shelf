<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- Flux shelf for SideFX Houdini.                                       -->
  <!-- This file IS the source; shelf install copies it to houdiniX.Y/toolbar. -->
  <!-- Edit here, then reinstall the Houdini shelf from the FLUX Shelf Manager. -->

  <tool name="flux_import_kinefx_character" label="Import KineFX" icon="MISC_python">
    <helpText><![CDATA[FLUX — Import a skinned asset (USD / FBX) as a KineFX character.
The imported mesh carries the boneCapture point attribute (skin weights from Maya),
joints matched by name. Pick the light-export root .usd (a *_LAST folder's root) or an .fbx.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou

sel = hou.ui.selectFile(
    title="FLUX - Import KineFX character",
    pattern="*.usd *.usda *.usdc *.usdz *.fbx",
    file_type=hou.fileType.Any,
    start_directory=hou.expandString("$HIP"),
)
if not sel:
    raise hou.InterruptedError()

path = hou.expandString(sel.strip())
ext = path.lower().rsplit(".", 1)[-1]
if ext in ("usd", "usda", "usdc", "usdz"):
    ntype = "kinefx::usdcharacterimport"
elif ext == "fbx":
    ntype = "kinefx::fbxcharacterimport"
else:
    hou.ui.displayMessage("Format non supporte: .%s (attendu usd*/fbx)" % ext,
                          severity=hou.severityType.Error)
    raise hou.InterruptedError()

# Target the current network; wrap in a Geometry node if we are in an OBJ context.
pane = hou.ui.paneTabOfType(hou.paneTabType.NetworkEditor)
net = (pane.pwd() if pane else None) or hou.node("/obj")
if net.childTypeCategory() == hou.objNodeTypeCategory():
    net = net.createNode("geo", node_name="flux_character")

node = net.createNode(ntype, node_name="flux_character_import")

# Find the file parm (version-agnostic): file-reference string parm, else name ~ "file".
fp = None
for p in node.parms():
    t = p.parmTemplate()
    try:
        if (t.type() == hou.parmTemplateType.String
                and t.stringType() == hou.stringParmType.FileReference):
            fp = p
            break
    except Exception:
        pass
if fp is None:
    for p in node.parms():
        if "file" in p.name().lower():
            fp = p
            break
if fp is not None:
    fp.set(path)

node.setSelected(True, clear_all_selected=True)
try:
    node.moveToGoodPosition()
except Exception:
    pass

has_bc = False
npt = 0
try:
    g = node.geometry()
    if g is not None:
        npt = g.intrinsicValue("pointcount")
        has_bc = g.findPointAttrib("boneCapture") is not None
except Exception as exc:
    hou.ui.displayMessage("Import cree mais cook en erreur:\n%s" % exc,
                          severity=hou.severityType.Warning)

msg = "Import KineFX: %s\nPoints: %s\nboneCapture: %s" % (
    node.path(), npt,
    "OUI" if has_bc else "NON (l'asset ne porte pas de skin weights)",
)
hou.ui.displayMessage(
    msg,
    severity=(hou.severityType.Message if has_bc else hou.severityType.Warning),
)
]]></script>
  </tool>

  <toolshelf name="flux" label="FLUX">
    <memberTool name="flux_import_kinefx_character"/>
  </toolshelf>
</shelfDocument>
