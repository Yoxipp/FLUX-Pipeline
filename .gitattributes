# Binary assets: never diff or convert line endings.
*.hda    binary
*.hip    binary
*.hipnc  binary
*.png    binary
*.ico    binary
*.exe    binary
*.usdc   binary
*.abc    binary
*.exr    binary
*.tx     binary
*.spexp  binary
*.cfg    binary

# ADR index: every branch appends its own line at the end of the table, so a merge
# keeps the lines of both sides without a conflict (built-in git driver, nothing to
# install). A number used twice is caught by backend/tests/system/test_adr_numbers.py.
docs/decisions/README.md merge=union
